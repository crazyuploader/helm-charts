{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^charts/n8n/Chart\\.yaml$/"],
      "matchStrings": ["appVersion:\\s*\"(?<currentValue>.*?)\""],
      "depNameTemplate": "n8nio/n8n",
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["n8nio/n8n"],
      "bumpVersion": "patch",
      "automerge": true,
      "automergeType": "pr",
      "commitMessageTopic": "n8n appVersion"
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
