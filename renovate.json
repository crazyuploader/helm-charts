{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^charts/n8n/Chart\\.yaml$/"],
      "matchStrings": ["appVersion:\\s*\"(?<currentValue>.*?)\""],
      "depNameTemplate": "n8n-io/n8n",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^n8n@(?<version>.*)$",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["n8n-io/n8n"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/",
      "bumpVersions": [
        {
          "name": "n8n chart version",
          "filePatterns": ["/^charts/n8n/Chart\\.yaml$/"],
          "matchStrings": ["\\nversion:\\s*(?<version>\\S+)"],
          "bumpType": "patch"
        }
      ],
      "automerge": true,
      "automergeType": "pr",
      "commitMessageTopic": "n8n appVersion"
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
